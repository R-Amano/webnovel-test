{
  "ra_scene_container":{//シーンコンテナ宣言、必須
    "meta":{//メタデータ、必須
      "id":"id1_1",//シーンid、必須
      "chapter":[1,"chapter title"],//章、章タイトル、書かない場合は無し
      "scene":[1,"scene title"],//話、話タイトル、書かない場合は無し
      "back_id":"id1_0"//前のシーン管理、戻るで使用、書かない場合は戻れない
    },
    "background":"url/bg.png",//背景イラスト、書かない場合は黒
    "panels":{//キャラパネルなど、書かない場合は無し
      "property":"character||item||panel",//パネルサイズプロパティ、キャラ絵サイズ、小四角、大四角、必須
      "url":"url",//パネルイラスト、必須
      "animation":"fade||pan||tilt",//実行時のパネルのアニメーション、無し、ふわっと出現、横揺れ、縦揺れ、書かない場合無し
      "emote":"url"//パネルの感嘆符テクスチャ、？、！、・・・、汗、書かない場合無し
    },
    "texts":{//セリフ設定、書かない場合は無し
      "name":"レイト",//キャラ名、書かない場合無し
      "text":["よう！","id1_2.json"],//セリフ、次の実行json、書かない場合無し、選択肢がある場合実行json無し
      "choices":[//選択肢、書かない場合無し
        {"label":"選択肢1","next_json":"id1_2.json"},//選択肢、書いたとき最低1つ必須
        {"label":"選択肢2","next_json":"id1_3.json"}
      ]
    },
    "transition":{//画面転換、書かないときは無し
      "color":"#000000",//暗転カラー
      "duration":1//暗転時間フィード前後1秒。プラス1秒、計3秒
    }  
  }
}